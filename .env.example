# Copy to .env and fill in. Never commit .env. See docs/CREDENTIALS.md.

# --- AWS (Bedrock, Polly, Transcribe) ---
# Prefer a named profile (SSO/CLI). Use access keys only if you have no profile.
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# --- Bedrock model / inference-profile IDs (copy exactly from the Bedrock console) ---
BEDROCK_MODEL_NOVA_SONIC=
BEDROCK_MODEL_SONNET=
BEDROCK_MODEL_HAIKU=
BEDROCK_MODEL_NOVA_MICRO=
BEDROCK_MODEL_NOVA_LITE=
BEDROCK_MODEL_NOVA_CANVAS=

# --- Voice ---
# Nova Sonic voice name (audition in Phase 2); Polly voice for the fallback path
NOVA_SONIC_VOICE=
POLLY_VOICE_ID=

# --- Wake word (Picovoice Porcupine) ---
PICOVOICE_ACCESS_KEY=
PORCUPINE_KEYWORD_PATH=assets/wakeword/hey-zoya_mac.ppn

# --- Memory (Supermemory) ---
SUPERMEMORY_API_KEY=
SUPERMEMORY_CONTAINER_TAG=zoya_user_1

# --- Browser ---
ZOYA_CHROME_PROFILE_DIR=~/.zoya/chrome-profile

# --- Behaviour limits ---
ZOYA_SOUND_PACK=zen
ZOYA_MAX_CONCURRENT_TASKS=3
ZOYA_MAX_TOOL_CALLS_PER_TASK=40
ZOYA_MAX_TASK_COST_USD=2
ZOYA_CONFIRMATION_TTL_SECONDS=60
ZOYA_CONFIRMATION_TIMEOUT_SECONDS=20

# --- Observability (optional) ---
ZOYA_LOG_LEVEL=INFO
ZOYA_TELEMETRY=off
OTEL_EXPORTER_OTLP_ENDPOINT=
