# Copy to .env and fill in. Never commit .env. See docs/CREDENTIALS.md.
# Only secrets and account-specific values live here; everything else is a constant in zoya/config.py.

# AWS — a named profile from `aws configure sso` (or `aws configure`)
AWS_PROFILE=
AWS_REGION=

# Bedrock model / inference-profile IDs — copy exactly from the Bedrock console
BEDROCK_MODEL_NOVA_SONIC=
BEDROCK_MODEL_SONNET=
BEDROCK_MODEL_HAIKU=
BEDROCK_MODEL_NOVA_MICRO=
BEDROCK_MODEL_NOVA_CANVAS=

# Wake word — https://console.picovoice.ai
PICOVOICE_ACCESS_KEY=

# Memory — https://console.supermemory.ai
SUPERMEMORY_API_KEY=
