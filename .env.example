# Copy to .env and fill in. Never commit .env. See docs/CREDENTIALS.md and docs/STACK.md.
# Only secrets and account-specific values live here; everything else is a constant in zoya/config.py.

# Brain provider: openai | fireworks | bedrock
MODEL_PROVIDER=
# Model IDs chosen by the Phase 0 benchmark (from the models your key lists)
BRAIN_MODEL=
VISION_MODEL=
ROUTER_MODEL=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Fireworks — https://fireworks.ai/account/api-keys
FIREWORKS_API_KEY=

# ElevenLabs — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Voice chosen by ear in Phase 0
ELEVENLABS_VOICE_ID=

# Memory — https://console.supermemory.ai
SUPERMEMORY_API_KEY=

# Optional: AWS (non-model services now; Bedrock later) — profile from `aws login`
AWS_PROFILE=
AWS_REGION=
