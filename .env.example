# Copy to .env and fill in. Never commit .env. See docs/CREDENTIALS.md.
# Only secrets and account-specific values live here; everything else is a constant in zoya/config.py.

# AWS — a named profile from `aws configure sso` (or `aws configure`)
AWS_PROFILE=zoya
# Tokyo: the nearest region to India that runs every Zoya model (incl. Nova 2 Sonic and Nova Canvas)
AWS_REGION=ap-northeast-1

# Bedrock model / inference-profile IDs — verified in ap-northeast-1 on 2026-09-14 via `aws bedrock list-inference-profiles`
# (jp./apac. profiles keep traffic in Japan/APAC; Sonnet 5 is offered only as a global profile here)
BEDROCK_MODEL_NOVA_SONIC=amazon.nova-2-sonic-v1:0
BEDROCK_MODEL_SONNET=global.anthropic.claude-sonnet-5
BEDROCK_MODEL_HAIKU=jp.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_NOVA_MICRO=apac.amazon.nova-micro-v1:0
BEDROCK_MODEL_NOVA_CANVAS=amazon.nova-canvas-v1:0
# Only for the screen-description benchmark (§17.1b)
BEDROCK_MODEL_NOVA_LITE=jp.amazon.nova-2-lite-v1:0

# Wake word — https://console.picovoice.ai
PICOVOICE_ACCESS_KEY=

# Memory — https://console.supermemory.ai
SUPERMEMORY_API_KEY=
