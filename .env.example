# ./start.sh creates .env from this file and asks only for missing keys. Never commit .env.
# Only secrets and account-specific values live here; everything else is a constant in zoya/config.py.

# Brain provider: openai | fireworks | bedrock
MODEL_PROVIDER=
# Model IDs chosen by the Phase 0 benchmark (from the models your key lists)
BRAIN_MODEL=
VISION_MODEL=
ROUTER_MODEL=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Fireworks — https://fireworks.ai/account/api-keys
FIREWORKS_API_KEY=

# ElevenLabs — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Voice chosen by ear in Phase 0
ELEVENLABS_VOICE_ID=

# Memory — https://console.supermemory.ai
SUPERMEMORY_API_KEY=

# AWS services (Polly, DynamoDB, SNS, S3, CloudWatch…; Bedrock later) — profile from `aws login`
AWS_PROFILE=
AWS_REGION=
# Provider keys are read from AWS Secrets Manager secret `zoya/providers` (JSON) when reachable;
# the values above are the fallback.
# Traces → CloudWatch/X-Ray: point at a local ADOT collector, e.g. http://localhost:4318 (leave empty = off)
OTEL_EXPORTER_OTLP_ENDPOINT=

# TinyFish Search/Fetch — https://docs.tinyfish.ai (Phase 4 web research)
TINYFISH_API_KEY=

# Jev — dev runs on the Vercel AI Gateway, production on first-party TypeSafe (D74)
# Gateway: https://vercel.com/docs/ai-gateway · TypeSafe: https://docs.typesafe.ai
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
# typesafe-ai/jev on the gateway; jev-latest on TypeSafe's own API
JEV_MODEL=
# Only once the TypeSafe waitlist clears
TYPESAFE_API_KEY=
