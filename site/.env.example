# Neon Postgres connection string. Unset in local dev: the waitlist writes to data/waitlist.jsonl and the visitor counter hides.
DATABASE_URL=
# Dodo Payments static payment link for the $20/month product (dashboard: Products → share). Unset: the site shows
# the waitlist form. Set: the hero and pricing become a "get zoya" link to it. Public, inlined at build time.
NEXT_PUBLIC_DODO_CHECKOUT_URL=
